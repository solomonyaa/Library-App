<Window x:Class="WpfLibrary.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfLibrary"
        mc:Ignorable="d" x:Name="MyReportWindow"
        WindowStyle="None"
        Title="ReportWindow" Height="450" Width="800" WindowStartupLocation="CenterScreen" >
    <Grid>
        <Grid>
            <TextBlock Text="Report Window" FontSize="18" FontWeight="SemiBold" Margin="5 5" TextAlignment="Center"/>
            <Button Content="X" FontSize="22" Click="Btn_Close" Height="30" Width="30" VerticalAlignment="Top" HorizontalAlignment="Right"/>
            <DataGrid x:Name="dgBooksReport" Height="300" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Title" Binding="{Binding Path=Title, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Author" Binding="{Binding Path=Author, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Price" Binding="{Binding Path=Price, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Edition" Binding="{Binding Path=Edition, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Publisher" Binding="{Binding Path=Publisher, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Publication Date" Binding="{Binding Path=PublicationDate, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Genere" Binding="{Binding Path=BookGenre, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Number of Copies" Binding="{Binding Path=NumOfCopies, Mode=OneWay}"/>
                    <DataGridTextColumn Header="ISBN" Binding="{Binding Path=Isbn, Mode=OneWay}"/>
                </DataGrid.Columns>
            </DataGrid>
            <DataGrid x:Name="dgJournalsReport" Height="300" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Title" Binding="{Binding Path=Title, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Price" Binding="{Binding Path=Price, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Edition" Binding="{Binding Path=Edition, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Publisher" Binding="{Binding Path=Publisher, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Publication Date" Binding="{Binding Path=PublicationDate, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Path=JournalCategory, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Number of Copies" Binding="{Binding Path=NumOfCopies, Mode=OneWay}"/>
                    <DataGridTextColumn Header="ISSN" Binding="{Binding Path=Issn, Mode=OneWay}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
