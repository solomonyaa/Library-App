<Window x:Class="WpfLibrary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfLibrary"
        mc:Ignorable="d"
        Title="Library Project" Height="850" Width="800" WindowState="Maximized" WindowStyle="SingleBorderWindow">

    <Grid Background="Beige">
        <Grid.ColumnDefinitions>
            <ColumnDefinition MaxWidth="300"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="1.7*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Vertical" Margin="10 5 5 5">
            <TextBlock Text="Create a new item" FontSize="18" FontWeight="SemiBold" Margin="5 25" TextAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Item Type: " Margin="5 8"/>
                <RadioButton x:Name="rdbtnBook" Content="Book" Margin="10 10"/>
                <RadioButton x:Name="rdbtnJournal" Content="Journal" Margin="10 10"/>
            </StackPanel>
            <StackPanel Margin="5">
                <TextBlock Text="Title: "/>
                <TextBox x:Name="tbxTitle" FontSize="14"/>
            </StackPanel>
            <StackPanel Margin="5">
                <TextBlock Text="Author: "/>
                <TextBox x:Name="tbxAuthor" FontSize="14"/>
            </StackPanel>
            <StackPanel Margin="5">
                <TextBlock Text="Price: "/>
                <TextBox x:Name="tbxPrice" FontSize="14"/>
            </StackPanel>
            <StackPanel Margin="5">
                <TextBlock Text="Discount Percentage: "/>
                <TextBox x:Name="tbxDiscount" FontSize="14"/>
            </StackPanel>
            <StackPanel Margin="5">
                <TextBlock Text="Edition: "/>
                <TextBox x:Name="tbxEdition" FontSize="14"/>
            </StackPanel>
            <StackPanel Margin="5">
                <TextBlock Text="Publisher: "/>
                <TextBox x:Name="tbxPublisher" FontSize="14"/>
            </StackPanel>

            <StackPanel  >
                <TextBlock Text="Publication Date: " Margin="5"/>
                <DatePicker HorizontalAlignment="Center" Name="datePicker1" Width="200" FontSize="14"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Grid.Row="2" Margin="5">
                <StackPanel Margin="5">
                    <TextBlock Text="Book Main Genre: "/>
                    <ComboBox x:Name="cmbxMainGenreBook" FontSize="14"/>
                </StackPanel>
                <StackPanel Margin="5">
                    <TextBlock Text="Book Sub Genre: "/>
                    <ComboBox x:Name="cmbxSubGenreBook" FontSize="14"/>
                </StackPanel>
                <StackPanel Margin="5">
                    <TextBlock Text="Journal Main Category: "/>
                    <ComboBox x:Name="cmbxMainCategoryJournal" FontSize="14"/>
                </StackPanel>
                <StackPanel Margin="5">
                    <TextBlock Text="Journal Sub Category: "/>
                    <ComboBox x:Name="cmbxSubCategoryJournal" FontSize="14"/>
                </StackPanel>
                <StackPanel Margin="5 10">
                    <Button Content="Add Item" Click="AddItemClick" Height="30" Width="200" HorizontalContentAlignment="Center" Margin="10" FontSize="14"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10" Orientation="Vertical" MaxWidth="230">
            <TextBlock Text="Generate Reports" FontSize="18" FontWeight="SemiBold" Margin="5 20" TextAlignment="Center"/>
            <TextBlock Text="Title: " Margin="2"/>
            <TextBox x:Name="tbxTitleToFind" Margin="2"/>
            <TextBlock Text="From Price: " Margin="2"/>
            <TextBox x:Name="tbxFromPrice" Margin="2"/>
            <TextBlock Text="To Price: " Margin="2"/>
            <TextBox x:Name="tbxToPrice" Margin="2"/>

            <TextBlock Text="Book Genres: " Margin="2"/>
            <CheckBox x:Name="chkbxAdventure" Content="Adventure" Margin="1"/>
            <CheckBox x:Name="chkbxComedy" Content="Comedy" Margin="1"/>
            <CheckBox x:Name="chkbxFantasy" Content="Fantasy" Margin="1"/>
            <CheckBox x:Name="chkbxHorror" Content="Horror" Margin="1"/>
            <CheckBox x:Name="chkbxMystery" Content="Mystery" Margin="1"/>
            <CheckBox x:Name="chkbxRomance" Content="Romance" Margin="1"/>

            <TextBlock Text="Type of books report: " Margin="2"/>
            <ComboBox x:Name="cmbxBookReport" Margin="2">
                <ComboBoxItem Content="By Title"></ComboBoxItem>
                <ComboBoxItem Content="By Price"></ComboBoxItem>
                <ComboBoxItem Content="By Genre"></ComboBoxItem>
                <ComboBoxItem Content="By Title and Price"></ComboBoxItem>
                <ComboBoxItem Content="By Title and Genre"></ComboBoxItem>
                <ComboBoxItem Content="By Price and Genre"></ComboBoxItem>
            </ComboBox>
            <Button Content="Generate Book Report" Click="GenerateReportOfBooks" Margin="2" Height="30"/>

            <TextBlock Text="Journal Categories: " Margin="2"/>
            <CheckBox x:Name ="chkbxScience" Content="Science" Margin="1"/>
            <CheckBox x:Name ="chkbxNature" Content="Nature" Margin="1"/>
            <CheckBox x:Name ="chkbxComputers" Content="Computers" Margin="1"/>
            <CheckBox x:Name ="chkbxGeography" Content="Geography" Margin="1"/>
            <CheckBox x:Name ="chkbxMedicine" Content="Medicine" Margin="1"/>
            <CheckBox x:Name ="chkbxCulture" Content="Culture" Margin="1"/>

            <TextBlock Text="Type of journals report: " Margin="2"/>
            <ComboBox x:Name="cmbxJournalReport" Margin="2">
                <ComboBoxItem Content="By Title"></ComboBoxItem>
                <ComboBoxItem Content="By Price"></ComboBoxItem>
                <ComboBoxItem Content="By Category"></ComboBoxItem>
                <ComboBoxItem Content="By Title and Price"></ComboBoxItem>
                <ComboBoxItem Content="By Title and Category"></ComboBoxItem>
                <ComboBoxItem Content="By Price and Category"></ComboBoxItem>
            </ComboBox>
            <Button Content="Generate Journal Report" Click="GenerateReportOfJournals" Margin="2" Height="30"/>
            <Button Content="Clear Report Fields" Click="ClearReportFields" Margin="20" Height="30"/>
            <TextBlock Text="Search Item By Title / ISBN / ISSN:" FontWeight="SemiBold"/>
            <TextBox x:Name="txtbxSearch" Height="26" FontSize="16"/>
            <Button Content="Search" Click="Invoke_Indexer" Height="30" Width="200" HorizontalContentAlignment="Center" Margin="5"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Margin="15" Orientation="Vertical">
            <TextBlock Text="Books Shelf" FontSize="18" FontWeight="SemiBold" Margin="5 5" TextAlignment="Center"/>
            <DataGrid x:Name="dgBooks" Height="300" AutoGenerateColumns="False" MouseDoubleClick="DG_Books_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Title" Binding="{Binding Path=Title, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Author" Binding="{Binding Path=Author, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Price" Binding="{Binding Path=Price, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Edition" Binding="{Binding Path=Edition, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Publisher" Binding="{Binding Path=Publisher, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Publication Date" Binding="{Binding Path=PublicationDate, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Genere" Binding="{Binding Path=BookGenre, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Number of Copies" Binding="{Binding Path=NumOfCopies, Mode=OneWay}"/>
                    <DataGridTextColumn Header="ISBN" Binding="{Binding Path=Isbn, Mode=OneWay}"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="Remove Book" Click="RemoveBook_Click" Height="30" Width="130" HorizontalContentAlignment="Center" Margin="5 5 20 5"/>
                <Button Content="Add Book Copies: " Click="Add_Book_Copies" Height="30" Width="130" HorizontalContentAlignment="Center" Margin="1 5"/>
                <TextBox x:Name="txtbxNumOfBookCopies" Height="30" Width="60" HorizontalContentAlignment="Center" FontSize="20" Margin="1 5"/>
            </StackPanel>


            <TextBlock Text="Journals Shelf" FontSize="18" FontWeight="SemiBold" Margin="5 5" TextAlignment="Center"/>
            <DataGrid x:Name="dgJournals" Height="300" AutoGenerateColumns="False" MouseDoubleClick="DG_Journals_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Title" Binding="{Binding Path=Title, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Price" Binding="{Binding Path=Price, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Edition" Binding="{Binding Path=Edition, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Publisher" Binding="{Binding Path=Publisher, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Publication Date" Binding="{Binding Path=PublicationDate, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Path=JournalCategory, Mode=OneWay}"/>
                    <DataGridTextColumn Header="Number of Copies" Binding="{Binding Path=NumOfCopies, Mode=OneWay}"/>
                    <DataGridTextColumn Header="ISSN" Binding="{Binding Path=Issn, Mode=OneWay}"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="Remove Journal" Click="RemoveJournal_Click" Height="30" Width="130" HorizontalContentAlignment="Center" Margin="5 5 20 5"/>
                <Button Content="Add Journal Copies: " Click="Add_Journal_Copies" Height="30" Width="130" HorizontalContentAlignment="Center" Margin="1 5"/>
                <TextBox x:Name="txtbxNumOfJournalCopies" Height="30" Width="60" HorizontalContentAlignment="Center" FontSize="20" Margin="1 5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
